// Data-driven game definitions (Cold-War-era starter faction).
// Authored content lives here, not in code. Schema is versioned (see `version`).
// Unit colors are white: the placeholder art (Kenney top-down tanks, CC0) is already
// colored, so we draw it untinted. Faction tinting returns later.
// speed = world px/s; turn_rate = rad/s (low = pivots before moving, like a tank).
Definitions(
    version: 1,
    factions: [
        (id: "vanguard", name: "Vanguard Bloc", color: (110, 160, 230)),
    ],
    units: [
        (id: "engineer", name: "Engineer",        faction: "vanguard", sprite: "engineer",  color: (255, 255, 255), radius: 9.0,  speed: 70.0, turn_rate: 6.0),
        (id: "infantry", name: "Infantry",        faction: "vanguard", sprite: "infantry",  color: (255, 255, 255), radius: 8.0,  speed: 82.0, turn_rate: 9.0),
        (id: "tank",     name: "Main Battle Tank", faction: "vanguard", sprite: "tank",      color: (255, 255, 255), radius: 12.0, speed: 60.0, turn_rate: 3.2),
        (id: "arty",     name: "Artillery",       faction: "vanguard", sprite: "artillery", color: (255, 255, 255), radius: 12.0, speed: 46.0, turn_rate: 2.4),
        (id: "aa",       name: "AA Vehicle",       faction: "vanguard", sprite: "aa",        color: (255, 255, 255), radius: 10.0, speed: 66.0, turn_rate: 4.0),
        (id: "truck",    name: "Supply Truck",     faction: "vanguard", sprite: "truck",     color: (255, 255, 255), radius: 11.0, speed: 78.0, turn_rate: 4.5),
    ],
)
